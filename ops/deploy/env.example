# Knockout Bash production environment. Copy to a file OUTSIDE the repository, chmod 600.
# Validated at startup by apps/server/src/config/env.ts; a bad value exits with code 78.
NODE_ENV=production
HOST=127.0.0.1
# 2567 is used by battle.cagdasatici.com on this host.
PORT=2568
PUBLIC_ORIGIN=https://fighter.cagdasatici.com
ROOM_CAPACITY=2
# Absolute, owner-only (chmod 700) directory outside the repository.
DATA_DIR=/Users/cagdas/kb-data
LOG_LEVEL=info
BUILD_ID=CHANGE-ME
# Cloudflare Access gate (same model as battle): OPEN_JOIN signs in anyone Access lets through.
OPEN_JOIN=1
CF_ACCESS_TEAM=raspy-cloud-c464
# Audience tag of the "fighter" Access application.
CF_ACCESS_AUD=c28f8a8e409f089118dd7e82ae8bd3558bf216ba4617a3adbf843fcc4493e857
